# ===========================================================================
# Copy to .env for local development, and set the same keys as environment
# variables in the Vercel dashboard for production.
# Nothing in this file is secret; it documents the names and shapes only.
# ===========================================================================

# --- Django core -----------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Never enable in production.
DJANGO_DEBUG=1

# Comma separated. Include the custom domain and the Vercel domain.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,onlinebrocoach.com,www.onlinebrocoach.com

# Comma separated, and the scheme is required.
DJANGO_CSRF_TRUSTED_ORIGINS=https://onlinebrocoach.com,https://www.onlinebrocoach.com

# Absolute base URL. Used to build the return URLs handed to Fawaterk, which
# cannot be relative. Leave unset on Vercel and it uses the deployment URL.
SITE_URL=https://onlinebrocoach.com

DJANGO_TIME_ZONE=Africa/Cairo

# Set to 1 only once every static asset referenced in CSS actually exists;
# manifest storage fails hard on a missing file.
DJANGO_STATIC_MANIFEST=0

# --- Database (Neon) -------------------------------------------------------
# Use the *pooled* Neon endpoint for serverless. Omit entirely to fall back to
# local SQLite.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=1

# --- Store -----------------------------------------------------------------
STORE_CURRENCY=EGP
STORE_CURRENCY_LABEL=EGP
STORE_SHIPPING_FEE=60
# Subtotal at or above which delivery is free. Set to 0 to disable the offer.
STORE_FREE_SHIPPING_THRESHOLD=1500
STORE_MAX_ITEM_QUANTITY=10
STORE_WHATSAPP_NUMBER=966578079833

# --- Fawaterk --------------------------------------------------------------
# NOTE: the live credentials are hardcoded in test_project/credentials.py at
# the owner's request. Everything below is OPTIONAL and only needed if you
# later want to move a secret out of the code. Any variable set here overrides
# the hardcoded value, so you can migrate them one at a time.
#
# FAWATERK_CLIENT_ID=
# FAWATERK_CLIENT_SECRET=
# FAWATERK_TOKEN_URL=https://app.fawaterk.com/oauth/token
# FAWATERK_HASH_KEY=
#
# 1 = app.fawaterk.com (live), 0 = staging.fawaterk.com
# FAWATERK_LIVE=1
FAWATERK_TIMEOUT=20
# Leave at 1. Only turn off to debug a signature mismatch, never in production.
FAWATERK_VERIFY_WEBHOOK=1

# --- Order notification email ----------------------------------------------
# Also configurable in test_project/credentials.py.
# Gmail needs an *app password*, not the account password.
# ORDER_NOTIFICATION_EMAIL=owner@example.com
# ORDER_NOTIFICATION_CC=
# NOTIFY_ON_COD_ORDER=1
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=orders@onlinebrocoach.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# DEFAULT_FROM_EMAIL=orders@onlinebrocoach.com

# --- TikTok ----------------------------------------------------------------
# Also configurable in test_project/credentials.py.
# TIKTOK_PIXEL_ID=
# TIKTOK_ACCESS_TOKEN=
# Set while testing so events land in the Test Events tab. Remove before launch.
TIKTOK_TEST_EVENT_CODE=
TIKTOK_DEFAULT_COUNTRY_CODE=20

# --- Logging ---------------------------------------------------------------
STORE_LOG_LEVEL=INFO
